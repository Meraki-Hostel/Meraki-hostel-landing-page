# All optional. Never commit real values. NEXT_PUBLIC_* are inlined at build time (rebuild after changing).
#
# Lead capture stays DISABLED until all three are true:
#   1. LEAD_WEBHOOK_URL is a valid https URL
#   2. NEXT_PUBLIC_CONTACT_EMAIL is a real, monitored address
#   3. The privacy notice is reviewed and src/config/legal.ts sets privacy.reviewStatus = "reviewed"
#
# Server-only. Endpoint that must reply JSON {"ok": true} only after it has stored the lead
# (http://localhost or http://127.0.0.1 allowed for local testing only). Plain Zapier Catch Hooks cannot do this.
LEAD_WEBHOOK_URL=
# Contact details shown on the page only when set (mailto:/tel:). The email is also the privacy/withdrawal contact.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Absolute origin, e.g. https://<your-domain>. Enables metadataBase, canonical URL and sitemap entries.
NEXT_PUBLIC_SITE_URL=
